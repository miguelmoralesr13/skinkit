{
  "name": "skinkit",
  "version": "0.0.1",
  "description": "Headless React components with re-look (tokens) and re-anatomy (skins) driven entirely by external CSS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./form": {
      "types": "./dist/components/DynamicForm/index.d.ts",
      "import": "./dist/components/DynamicForm/index.js"
    },
    "./styles/base": "./src/styles/index.css",
    "./skins/soft": "./src/styles/skins/soft.css",
    "./skins/brutal": "./src/styles/skins/brutal.css",
    "./skins/minimal": "./src/styles/skins/minimal.css",
    "./skins/glass": "./src/styles/skins/glass.css",
    "./skins/retro": "./src/styles/skins/retro.css",
    "./skins/elevated": "./src/styles/skins/elevated.css",
    "./skins/clay": "./src/styles/skins/clay.css",
    "./skins/outline": "./src/styles/skins/outline.css",
    "./skins/sketch": "./src/styles/skins/sketch.css",
    "./skins/spotlight": "./src/styles/skins/spotlight.css",
    "./skins/terminal": "./src/styles/skins/terminal.css",
    "./skins/gradient": "./src/styles/skins/gradient.css",
    "./skins/aurora": "./src/styles/skins/aurora.css",
    "./skins/glow": "./src/styles/skins/glow.css",
    "./skins/holo": "./src/styles/skins/holo.css",
    "./themes/paper": "./src/styles/tokens/themes/paper.css",
    "./themes/dusk": "./src/styles/tokens/themes/dusk.css",
    "./themes/forest": "./src/styles/tokens/themes/forest.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite build && vite preview",
    "shots": "node scripts/capture-skins.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "zod": ">=3",
    "@hookform/resolvers": ">=3"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  }
}
