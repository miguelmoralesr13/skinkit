{
  "name": "skinkit",
  "version": "0.1.0",
  "description": "Headless React components styled by a single Tailwind-native design-token system (colors + shape), fully overridable via CSS variables or your own Tailwind config.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./form": {
      "types": "./dist/components/DynamicForm/index.d.ts",
      "import": "./dist/components/DynamicForm/index.js"
    },
    "./styles/base": "./dist/styles/skinkit.css",
    "./tailwind-preset": "./src/styles/tokens.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup && tsc -p tsconfig.build.json && npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles/skinkit.css --minify",
    "typecheck": "tsc --noEmit",
    "preview": "vite build && vite preview",
    "shots": "node scripts/capture-components.mjs"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "zod": ">=3",
    "@hookform/resolvers": ">=3"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  }
}
